[Unit]
Description=Omarchy fan tray monitor (gray OK / flashing red-yellow on failure)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Threshold/interval can be tuned here. 500 RPM default: red below that.
ExecStart=%h/ws/omarchy-fan-tray/fan_tray.py --threshold 500 --interval 2
Restart=on-failure
RestartSec=5
Environment=GDK_BACKEND=wayland,x11

[Install]
WantedBy=default.target
